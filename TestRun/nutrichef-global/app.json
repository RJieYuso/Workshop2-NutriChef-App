{
  "expo": {
    "name": "nutrichef-global",
    "slug": "nutrichef-global",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppLogo2.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/AppLogo2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppLogo2.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/AppLogo2.png"
    },
    "plugins": [
      "sentry-expo",
      "expo-asset",
      "expo-font"
    ]
  }
}